<Window
    x:Class="ZenithAudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Zenith Audio">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/Logo.png"
                       Width="52"
                       Height="52"
                       Stretch="Uniform" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Zenith Audio" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Mesa de escucha bit-perfect"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox x:Name="BackendComboBox" Width="166" SelectedIndex="0" SelectionChanged="BackendComboBox_SelectionChanged">
                    <ComboBoxItem Content="BASS WASAPI" Tag="BassWasapi" />
                    <ComboBoxItem Content="MPV WASAPI" Tag="MpvWasapi" />
                </ComboBox>

                <ToggleSwitch x:Name="ExclusiveModeToggle"
                              Header="Exclusivo"
                              IsOn="True"
                              Toggled="ExclusiveModeToggle_Toggled" />

                <Button x:Name="OpenFileButton" Click="OpenFileButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                        <TextBlock Text="Abrir archivo" />
                    </StackPanel>
                </Button>

                <Button x:Name="ZenithAiButton"
                        Click="ZenithAiButton_Click"
                        ToolTipService.ToolTip="ZenitAI (BETA) para música, formatos y escucha audiófila">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D4;" FontSize="15" />
                        <TextBlock Text="ZenitAI (BETA)" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border CornerRadius="8"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Stretch" Click="ShowMusicFoldersButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                <TextBlock Text="Carpetas de música" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Click="ShowDsdLibraryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE142;" FontSize="15" />
                                <TextBlock Text="Álbumes DSD" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Click="ShowHiResLibraryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8D6;" FontSize="15" />
                                <TextBlock Text="Hi-Res PCM" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Click="ShowSettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="15" />
                                <TextBlock Text="Ajustes" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        CornerRadius="8"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LibraryBrowserTitleTextBlock" Text="Explorador de biblioteca" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="LibraryBrowserSubtitleTextBlock"
                                       Text="Agrega una carpeta de música para escanear pistas"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <AutoSuggestBox x:Name="LibrarySearchBox"
                                            PlaceholderText="Buscar canción, álbum o formato"
                                            TextChanged="LibrarySearchBox_TextChanged">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE721;" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                        </StackPanel>
                        <ListView x:Name="LibraryBrowserListView"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="LibraryBrowserListView_ItemClick"
                                  DoubleTapped="LibraryBrowserListView_DoubleTapped" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        CornerRadius="8"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Perfil de dispositivo" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="DeviceProfileComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="DAC neutral" />
                            <ComboBoxItem Content="KZ Carol Pro" />
                            <ComboBoxItem Content="Moondrop" />
                            <ComboBoxItem Content="Sennheiser HD" />
                            <ComboBoxItem Content="Sony IER" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    CornerRadius="8"
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Reproduciendo ahora"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TrackTitleTextBlock"
                                       Text="No hay archivo cargado"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="TrackPathTextBlock"
                                       Text="Abre un archivo DSF, DFF, FLAC, WAV, AIFF, ALAC o MQA"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Padding="10,6"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="TransportBadgeTextBlock"
                                       Text="LISTO"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="18" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="250"
                                MinHeight="360"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="250" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border CornerRadius="8" Background="#10141D">
                                    <Grid>
                                        <Image x:Name="CoverArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed" />
                                        <StackPanel x:Name="CoverPlaceholderPanel"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                                    Spacing="8">
                                            <TextBlock Text="ZENITH"
                                                       HorizontalAlignment="Center"
                                                       FontSize="34"
                                                       FontWeight="SemiBold"
                                                       Foreground="#76C8FF" />
                                            <TextBlock Text="SIN CARATULA"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Spacing="6" Margin="4,0,4,4">
                                    <TextBlock x:Name="AlbumTitleTextBlock"
                                               Text="Carátula del álbum"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CoverHintTextBlock"
                                               Text="Busca cover.jpg/png en la carpeta"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border CornerRadius="8"
                                    Padding="12,10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Modo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ModeTextBlock" Text="Bit-perfect" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Motor" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BackendTextBlock" Text="BASS" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Buffer" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BufferTextBlock" Text="100 ms" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TabView Grid.Row="1"
                                     IsAddTabButtonVisible="False"
                                     CanDragTabs="False"
                                     TabWidthMode="Equal">
                                <TabViewItem Header="Escucha">
                                    <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border CornerRadius="8"
                                        Padding="16"
                                        Background="#101B2A"
                                        BorderBrush="#356B9C"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <TextBlock Text="MEDIDOR ZENITH"
                                                       Foreground="#8ED8FF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="VuPeakTextBlock"
                                                       Text="-inf dB"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#CDEFFF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Margin="0,12"
                                                CornerRadius="8"
                                                BorderBrush="#5DBFFF"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#46BFFF" Offset="0" />
                                                    <GradientStop Color="#1D79B8" Offset="0.58" />
                                                    <GradientStop Color="#0A233A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Viewbox Stretch="Uniform"
                                                     StretchDirection="Both"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch">
                                                <Grid Width="314" Height="178">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Canvas>
                                                        <Rectangle x:Name="VuBar01" Canvas.Left="28" Canvas.Top="122" Width="12" Height="24" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.18" />
                                                        <Rectangle x:Name="VuBar02" Canvas.Left="48" Canvas.Top="110" Width="12" Height="36" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.22" />
                                                        <Rectangle x:Name="VuBar03" Canvas.Left="68" Canvas.Top="94" Width="12" Height="52" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.24" />
                                                        <Rectangle x:Name="VuBar04" Canvas.Left="88" Canvas.Top="86" Width="12" Height="60" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.28" />
                                                        <Rectangle x:Name="VuBar05" Canvas.Left="108" Canvas.Top="72" Width="12" Height="74" RadiusX="4" RadiusY="4" Fill="#D7F8FF" Opacity="0.28" />
                                                        <Rectangle x:Name="VuBar06" Canvas.Left="128" Canvas.Top="62" Width="12" Height="84" RadiusX="4" RadiusY="4" Fill="#D7F8FF" Opacity="0.30" />
                                                        <Rectangle x:Name="VuBar07" Canvas.Left="148" Canvas.Top="58" Width="12" Height="88" RadiusX="4" RadiusY="4" Fill="#D7F8FF" Opacity="0.32" />
                                                        <Rectangle x:Name="VuBar08" Canvas.Left="168" Canvas.Top="68" Width="12" Height="78" RadiusX="4" RadiusY="4" Fill="#D7F8FF" Opacity="0.30" />
                                                        <Rectangle x:Name="VuBar09" Canvas.Left="188" Canvas.Top="76" Width="12" Height="70" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.28" />
                                                        <Rectangle x:Name="VuBar10" Canvas.Left="208" Canvas.Top="90" Width="12" Height="56" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.24" />
                                                        <Rectangle x:Name="VuBar11" Canvas.Left="228" Canvas.Top="104" Width="12" Height="42" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.22" />
                                                        <Rectangle x:Name="VuBar12" Canvas.Left="248" Canvas.Top="118" Width="12" Height="28" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.18" />
                                                        <Rectangle x:Name="VuBar13" Canvas.Left="268" Canvas.Top="126" Width="12" Height="20" RadiusX="4" RadiusY="4" Fill="#A8ECFF" Opacity="0.16" />

                                                        <Line X1="34" Y1="128" X2="280" Y2="128" Stroke="#DFF6FF" StrokeThickness="1" Opacity="0.55" />
                                                        <Line X1="58" Y1="104" X2="252" Y2="104" Stroke="#DFF6FF" StrokeThickness="1" Opacity="0.35" />
                                                        <Line X1="84" Y1="80" X2="224" Y2="80" Stroke="#DFF6FF" StrokeThickness="1" Opacity="0.28" />
                                                        <TextBlock Canvas.Left="30" Canvas.Top="136" Text="-40" Foreground="#07111B" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Canvas.Left="88" Canvas.Top="108" Text="-20" Foreground="#07111B" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Canvas.Left="154" Canvas.Top="84" Text="-7" Foreground="#07111B" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Canvas.Left="220" Canvas.Top="108" Text="0" Foreground="#07111B" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Canvas.Left="262" Canvas.Top="136" Text="+3" Foreground="#07111B" FontSize="12" FontWeight="SemiBold" />
                                                    </Canvas>

                                                    <Line x:Name="VuNeedleLine"
                                                          X1="157"
                                                          Y1="156"
                                                          X2="157"
                                                          Y2="42"
                                                          Stroke="#070A0F"
                                                          StrokeThickness="4"
                                                          StrokeEndLineCap="Triangle">
                                                        <Line.RenderTransform>
                                                            <RotateTransform x:Name="VuNeedleTransform"
                                                                             CenterX="157"
                                                                             CenterY="156"
                                                                             Angle="-36" />
                                                        </Line.RenderTransform>
                                                    </Line>

                                                    <Ellipse Width="16"
                                                             Height="16"
                                                             Fill="#06080C"
                                                             Stroke="#B9E9FF"
                                                             StrokeThickness="1"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,0,14" />

                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Spacing="18"
                                                                Margin="0,0,0,8">
                                                        <TextBlock Text="IZQ" Foreground="#CDEFFF" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="VuLevelTextBlock" Text="0%" Foreground="#07111B" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="DER" Foreground="#CDEFFF" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Grid>
                                            </Viewbox>
                                        </Border>

                                        <TextBlock Grid.Row="2"
                                                   Text="VU Meter digital"
                                                   Foreground="#8ED8FF"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <TextBlock Text="Letra"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="LyricsStatusTextBlock"
                                                       Text="local"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="12" />
                                        </Grid>

                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="12">
                                                <TextBlock x:Name="CurrentLyricTextBlock"
                                                           Text="Letra sincronizada no disponible"
                                                           TextWrapping="Wrap"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="LyricsTextBlock"
                                                           Text="Sin letra local. Zenith buscará un archivo .lrc o .txt con el mismo nombre de la canción."
                                                           TextWrapping="Wrap"
                                                           FontSize="14"
                                                           LineHeight="21"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                    </Grid>
                                </TabViewItem>

                                <TabViewItem Header="Laboratorio Anti-Fake">
                                    <Grid RowSpacing="14" Padding="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Auditoría visual de alta resolución"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="LabAuthenticityTextBlock"
                                                           Text="Autenticidad: pendiente de análisis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Analizar pista"
                                                    Click="AnalyzeCurrentTrackButton_Click"
                                                    VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Grid.Row="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Background="#08111B"
                                                BorderBrush="#2F6F9F"
                                                BorderThickness="1">
                                            <Grid RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid ColumnSpacing="3" VerticalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Fill="#12324A" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="1" Fill="#174B65" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="2" Fill="#1F6F86" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="3" Fill="#3B9C94" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="4" Fill="#57B26C" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="5" Fill="#9CC75A" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="6" Fill="#DBB34B" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="7" Fill="#C8793A" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="8" Fill="#226E9D" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="9" Fill="#1C587D" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="10" Fill="#194666" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="11" Fill="#14384F" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="12" Fill="#102D43" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="13" Fill="#0E2639" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="14" Fill="#0B2030" RadiusX="2" RadiusY="2" />
                                                    <Rectangle Grid.Column="15" Fill="#091A28" RadiusX="2" RadiusY="2" />
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <TextBlock Text="20 Hz" Foreground="#9FC7DA" FontSize="12" />
                                                    <TextBlock Text="22 kHz" Foreground="#9FC7DA" FontSize="12" HorizontalAlignment="Center" />
                                                    <TextBlock Text="96 kHz+" Foreground="#9FC7DA" FontSize="12" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <TextBlock x:Name="LabFindingTextBlock"
                                                   Grid.Row="2"
                                                   Text="Carga una pista y ejecuta el análisis. Esta vista queda preparada para el espectrograma real y detección de brickwall."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </TabViewItem>

                                <TabViewItem Header="Letras">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Letra sincronizada"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text, ElementName=CurrentLyricTextBlock}"
                                                       TextWrapping="Wrap"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Text, ElementName=LyricsTextBlock}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabViewItem>
                            </TabView>
                        </Grid>
                    </Grid>

                    <MediaPlayerElement x:Name="FallbackPlayerElement"
                                        Grid.Row="1"
                                        AreTransportControlsEnabled="False"
                                        Visibility="Collapsed" />

                    <InfoBar Grid.Row="2"
                             x:Name="StatusInfoBar"
                             Title="Estado"
                             Message="Listo"
                             Severity="Informational"
                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                             IsOpen="True" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="RightPanelScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border x:Name="SystemSettingsBorder"
                            CornerRadius="8"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="BitPerfectStatusLed"
                                         Width="12"
                                         Height="12"
                                         Fill="#9AA0A6"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Cadena de señal" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Estado técnico del renderizado"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Bitrate" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="BitrateTextBlock" Text="-- kbps" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Frecuencia" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SampleRateTextBlock" Text="-- kHz" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="Profundidad" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="BitDepthTextBlock" Text="-- bit" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Canales" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ChannelsTextBlock" Text="--" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                                    <TextBlock Text="Codec" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="CodecTextBlock" Text="Esperando archivo" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Border CornerRadius="6"
                                    Padding="12"
                                    Background="#10141D"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Flujo de bits"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SourceFlowPill" CornerRadius="6" Padding="8,7" Background="#182235" BorderBrush="#3A465C" BorderThickness="1">
                                            <TextBlock Text="Archivo" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text=">" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border x:Name="DecoderFlowPill" Grid.Column="2" CornerRadius="6" Padding="8,7" Background="#182235" BorderBrush="#3A465C" BorderThickness="1">
                                            <TextBlock Text="Decoder" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text=">" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border x:Name="DspFlowPill" Grid.Column="4" CornerRadius="6" Padding="8,7" Background="#182235" BorderBrush="#3A465C" BorderThickness="1">
                                            <TextBlock Text="DSP" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="5" Text=">" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border x:Name="OutputFlowPill" Grid.Column="6" CornerRadius="6" Padding="8,7" Background="#182235" BorderBrush="#3A465C" BorderThickness="1">
                                            <TextBlock Text="Salida" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="6"
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fuente" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalSourceTextBlock"
                                                   Grid.Column="1"
                                                   Text="Sin archivo"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Decodifica" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalDecodeTextBlock"
                                                   Grid.Column="1"
                                                   Text="Inactivo"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DSP" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalDspTextBlock"
                                                   Grid.Column="1"
                                                   Text="Bypass"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Salida" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalOutputTextBlock"
                                                   Grid.Column="1"
                                                   Text="Windows predeterminado"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bit-perfect" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalBitPerfectTextBlock"
                                                   Grid.Column="1"
                                                   Text="Sin validar"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dither" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalDitherTextBlock"
                                                   Grid.Column="1"
                                                   Text="Auto"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Buffer" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SignalBufferTextBlock"
                                                   Grid.Column="1"
                                                   Text="100 ms | manual"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Control de tono" FontSize="18" FontWeight="SemiBold" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Perfil AutoEQ" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <AutoSuggestBox x:Name="AutoEqSearchBox"
                                                PlaceholderText="Buscar perfil de audifonos" />
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="EqToggleButton"
                                          Content="EQ"
                                          Checked="ToneControl_Changed"
                                          Unchecked="ToneControl_Changed" />
                                <CheckBox x:Name="DspBypassToggleButton"
                                          Grid.Column="1"
                                          Content="Omitir DSP"
                                          IsChecked="True"
                                          Checked="ToneControl_Changed"
                                          Unchecked="ToneControl_Changed" />
                            </Grid>

                            <ComboBox x:Name="EqPresetComboBox"
                                      Header="Preajuste"
                                      SelectedIndex="0"
                                      SelectionChanged="EqPresetComboBox_SelectionChanged"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Referencia plana" />
                                <ComboBoxItem Content="Parametrico 10 bandas" />
                                <ComboBoxItem Content="Grafico 31 bandas" />
                                <ComboBoxItem Content="AutoEQ importado" />
                            </ComboBox>

                            <Slider x:Name="PreampSlider" Minimum="-12" Maximum="12" Value="0" StepFrequency="0.5" Header="Preamplificación (dB)" ValueChanged="ToneSlider_ValueChanged" />
                            <Slider x:Name="SubBassSlider" Minimum="-6" Maximum="6" Value="0" StepFrequency="0.5" Header="Subgraves" ValueChanged="ToneSlider_ValueChanged" />
                            <Slider x:Name="PresenceSlider" Minimum="-6" Maximum="6" Value="0" StepFrequency="0.5" Header="Presencia" ValueChanged="ToneSlider_ValueChanged" />
                            <Slider x:Name="AirSlider" Minimum="-6" Maximum="6" Value="0" StepFrequency="0.5" Header="Aire" ValueChanged="ToneSlider_ValueChanged" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ToneSummaryTextBlock"
                                           Text="DSP omitido | Plano"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="ResetToneButton_Click">
                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Ajustes del sistema" FontSize="18" FontWeight="SemiBold" />

                            <ComboBox x:Name="OutputDeviceComboBox"
                                      Header="Dispositivo de salida"
                                      SelectionChanged="OutputDeviceComboBox_SelectionChanged"
                                      HorizontalAlignment="Stretch" />

                            <Button Click="RefreshOutputDevicesButton_Click" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Actualizar dispositivos de audio" />
                                </StackPanel>
                            </Button>

                            <ComboBox x:Name="PreferredFormatComboBox" Header="Formato de salida preferido" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Igualar fuente bit-perfect" />
                                <ComboBoxItem Content="PCM 24-bit / 192 kHz" />
                                <ComboBoxItem Content="PCM 32-bit float" />
                                <ComboBoxItem Content="DSD nativo cuando este disponible" />
                            </ComboBox>

                            <ComboBox x:Name="DsdModeComboBox"
                                      Header="Modo de reproducción DSD"
                                      SelectedIndex="0"
                                      SelectionChanged="DsdModeComboBox_SelectionChanged"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Auto: DSD nativo, respaldo DoP" />
                                <ComboBoxItem Content="Solo DSD nativo" />
                                <ComboBoxItem Content="DoP sobre PCM" />
                                <ComboBoxItem Content="Convertir DSD a PCM (requiere decodificador)" />
                            </ComboBox>

                            <ComboBox x:Name="DitherPolicyComboBox"
                                      Header="Dither"
                                      SelectedIndex="2"
                                      SelectionChanged="DitherPolicyComboBox_SelectionChanged"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Nunca" />
                                <ComboBoxItem Content="Siempre" />
                                <ComboBoxItem Content="Solo al reducir bits" />
                                <ComboBoxItem Content="Automático audiófilo" />
                            </ComboBox>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Herramientas SACD" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SacdToolStatusTextBlock"
                                           Text="sacd_extract.exe no configurado"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="SacdToolSelectButton"
                                        Click="SelectSacdExtractorButton_Click"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                        <TextBlock Text="Seleccionar sacd_extract.exe" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="GaplessPlaybackCheckBox" Content="Sin pausas" IsChecked="True" />
                                <CheckBox x:Name="ReplayGainCheckBox" Grid.Column="1" Content="ReplayGain" />
                            </Grid>

                            <Slider x:Name="BufferSlider"
                                    Minimum="50"
                                    Maximum="500"
                                    Value="100"
                                    StepFrequency="10"
                                    Header="Buffer WASAPI (ms)"
                                    ValueChanged="BufferSlider_ValueChanged" />

                            <Slider x:Name="LatencySlider"
                                    Minimum="25"
                                    Maximum="1000"
                                    Value="100"
                                    StepFrequency="25"
                                    Header="Latencia objetivo de audio (ms)"
                                    ValueChanged="LatencySlider_ValueChanged" />

                            <Slider x:Name="ScanThreadsSlider"
                                    Minimum="1"
                                    Maximum="12"
                                    Value="4"
                                    StepFrequency="1"
                                    Header="Hilos del escáner de biblioteca"
                                    ValueChanged="ScanThreadsSlider_ValueChanged" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Carpetas de biblioteca musical" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="LibraryFoldersListView" MinHeight="84" SelectionMode="Single" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Button Click="UseWindowsMusicButton_Click" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="Usar Musica de Windows" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Click="AddMusicFolderButton_Click" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xECC8;" FontSize="14" />
                                            <TextBlock Text="Agregar carpeta" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Desarrollado por"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="Felipe Espinoza 'XN1ll0X' (Chile)"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                CornerRadius="8"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ShuffleButton" Click="ShuffleButton_Click" Width="44" Height="40">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>

                <Button x:Name="PlayButton" Grid.Column="1" Click="PlayButton_Click" IsEnabled="False" Width="44" Height="40">
                    <FontIcon Glyph="&#xE768;" />
                </Button>

                <Button x:Name="PauseButton" Grid.Column="2" Click="PauseButton_Click" IsEnabled="False" Width="44" Height="40">
                    <FontIcon Glyph="&#xE769;" />
                </Button>

                <Button x:Name="StopButton" Grid.Column="3" Click="StopButton_Click" IsEnabled="False" Width="44" Height="40">
                    <FontIcon Glyph="&#xE71A;" />
                </Button>

                <Button x:Name="NextButton" Grid.Column="4" Click="NextButton_Click" Width="44" Height="40">
                    <FontIcon Glyph="&#xE893;" />
                </Button>

                <TextBlock x:Name="CurrentTimeTextBlock"
                           Grid.Column="5"
                           Text="0:00"
                           VerticalAlignment="Center"
                           MinWidth="44"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Slider x:Name="PlaybackProgressSlider"
                        Grid.Column="6"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        Header="Reproduccion"
                        PointerPressed="PlaybackProgressSlider_PointerPressed"
                        PointerReleased="PlaybackProgressSlider_PointerReleased"
                        ValueChanged="PlaybackProgressSlider_ValueChanged" />

                <StackPanel Grid.Column="7" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="VolumeTextBlock"
                               Text="Volumen 100%"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Width="120"
                            StepFrequency="1"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>

                <StackPanel Grid.Column="8" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="DurationTextBlock"
                               Text="0:00"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Ruta de reproducción" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OutputPathTextBlock"
                               Text="DAC exclusivo"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

