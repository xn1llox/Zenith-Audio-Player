                                            <Button Grid.Row="1" Grid.Column="1" Content="Menos agudos" HorizontalAlignment="Stretch" CornerRadius="8" Tag="quiero menos agudos" Click="ZenithAiQuickAction_Click" />
                                            <Button Grid.Row="1" Grid.Column="2" Content="Más cálido" HorizontalAlignment="Stretch" CornerRadius="8" Tag="quiero audio mas calido" Click="ZenithAiQuickAction_Click" />
                                            <Button Grid.Row="2" Content="Más detalle" HorizontalAlignment="Stretch" CornerRadius="8" Tag="quiero mas detalle" Click="ZenithAiQuickAction_Click" />
                                            <Button Grid.Row="2" Grid.Column="1" Content="Voces al frente" HorizontalAlignment="Stretch" CornerRadius="8" Tag="quiero voces al frente" Click="ZenithAiQuickAction_Click" />
                                            <Button Grid.Row="2" Grid.Column="2" Content="Automático" HorizontalAlignment="Stretch" CornerRadius="8" Tag="ajusta el perfil automatico segun la musica" Click="ZenithAiQuickAction_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW 2: DEDICATED PROVIDER-AGNOSTIC API & MODEL DISCOVERY MENU -->
                        <ScrollViewer x:Name="ZenithAiApiSettingsPanel"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Padding="2,4,8,4">
                                <!-- Step 1: Provider & Credentials -->
                                <Border CornerRadius="10"
                                        Padding="14"
                                        Background="#040C16"
                                        BorderBrush="#163D5C"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="1. PROVEEDOR Y CONEXIÓN (CUALQUIER API OPENAI-COMPATIBLE)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="70"
                                                   Foreground="#6CC5F5" />

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="ZenithAiProviderPresetComboBox"
                                                      Header="Plantilla de proveedor"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="ZenithAiProviderPresetComboBox_SelectionChanged" />

                                            <TextBox x:Name="ZenithAiProviderTextBox"
                                                     Grid.Column="1"
                                                     Header="Nombre del proveedor"
                                                     PlaceholderText="NVIDIA NIM, OpenAI, OpenRouter, Ollama..." />
                                        </Grid>

                                        <TextBox x:Name="ZenithAiEndpointTextBox"
                                                 Header="Endpoint base o /chat/completions"
                                                 PlaceholderText="https://integrate.api.nvidia.com/v1/chat/completions"
                                                 TextWrapping="NoWrap" />

                                        <PasswordBox x:Name="ZenithAiApiKeyBox"
                                                     Header="API Key (protegida con DPAPI · opcional en Ollama / LM Studio local)"
                                                     PlaceholderText="Pega aquí tu API key (se acepta con o sin prefijo Bearer)" />
                                    </StackPanel>
                                </Border>

                                <!-- Step 2: Universal Live Model Discovery -->
                                <Border CornerRadius="10"
                                        Padding="14"
                                        Background="#040C16"
                                        BorderBrush="#163D5C"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="2. EXTRAER Y ESCOGER MODELO"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           CharacterSpacing="70"
                                                           Foreground="#6CC5F5" />
                                                <TextBlock x:Name="ZenithAiModelsCountTextBlock"
                                                           Text="Pulsa 'Extraer modelos' para consultar el catálogo en vivo del proveedor elegido."
                                                           FontSize="11"
                                                           Foreground="#84A8C2"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="ZenithAiFetchModelsButton"
                                                        Click="ZenithAiFetchModelsButton_Click"
                                                        CornerRadius="8"
                                                        Background="#083250"
                                                        BorderBrush="#278ED0"
                                                        Foreground="#E6F6FF">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                        <TextBlock Text="Extraer modelos" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="ZenithAiTestConnectionButton"
                                                        Click="ZenithAiTestConnectionButton_Click"
                                                        CornerRadius="8"
                                                        Background="#071828"
                                                        BorderBrush="#194466">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#6CD1FF" />
                                                        <TextBlock Text="Probar" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <TextBox x:Name="ZenithAiModelFilterTextBox"
                                                 PlaceholderText="Filtrar modelos extraídos (ej. nemotron, llama, qwen, gpt, gemini, deepseek, claude)..."
                                                 TextChanged="ZenithAiModelFilterTextBox_TextChanged" />

                                        <Border CornerRadius="8"
                                                Background="#020810"
                                                BorderBrush="#12324B"
                                                BorderThickness="1"
                                                Height="170">
                                            <ListView x:Name="ZenithAiModelsListView"
                                                      SelectionMode="Single"
                                                      IsItemClickEnabled="True"
                                                      ItemClick="ZenithAiModelsListView_ItemClick">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="8,3" />
                                                        <Setter Property="MinHeight" Value="34" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="1" MinWidth="0">
                                                                <TextBlock Text="{Binding Id}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E6F5FF"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}"
                                                                           FontSize="10"
                                                                           Foreground="#789EB8"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    CornerRadius="5"
                                                                    Padding="6,2"
                                                                    Background="#08243A"
                                                                    BorderBrush="#1D5A82"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ContextBadge}"
                                                                           FontSize="10"
                                                                           Foreground="#9AD7FF" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Border>

                                        <TextBox x:Name="ZenithAiModelTextBox"
                                                 Header="Modelo activo (seleccionado de la lista o escrito manualmente)"
                                                 PlaceholderText="nvidia/nemotron-3-super-120b-a12b" />
                                    </StackPanel>
                                </Border>

                                <!-- Save / Restore -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Guardar y abrir Chat"
                                            CornerRadius="8"
                                            Padding="16,8"
                                            Background="#0A4C78"
                                            BorderBrush="#38B6FF"
                                            Foreground="#EAF7FF"
                                            Click="ZenithAiSaveApiButton_Click" />
                                    <Button Content="Restaurar NVIDIA NIM"
                                            CornerRadius="8"
                                            Padding="14,8"
                                            Click="ZenithAiResetApiButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock x:Name="ZenithAiStatusTextBlock"
                               Grid.Row="3"
                               FontSize="12"
                               TextWrapping="WrapWholeWords"
                               Foreground="#8EB2CC" />
                </Grid>
            </Border>
        </Grid>

        <!-- LAN REMOTE CONTROL FLOATING PANEL -->
        <Grid x:Name="RemoteControlOverlayGrid"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#66000000"
              Padding="16"
              PointerPressed="RemoteControlOverlayGrid_PointerPressed">
            <Border x:Name="RemoteControlPanelBorder"
                    Width="430"
                    MaxHeight="620"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,56,4,0"
                    CornerRadius="14"
                    Padding="18"
                    Background="#030A13"
                    BorderBrush="#1F6490"
                    BorderThickness="1"
                    PointerPressed="RemoteControlPanelBorder_PointerPressed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Header -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Control Remoto Web (LAN)"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#EAF6FF" />
                                <TextBlock Text="Controla Zenith Audio desde tu teléfono por Wi-Fi"
                                           FontSize="11"
                                           Foreground="#7DA5C0" />
                            </StackPanel>

                            <Border x:Name="RemoteStateBadgeBorder"
                                    Grid.Column="1"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="#071726"
                                    BorderBrush="#1B4766"
                                    BorderThickness="1">
                                <TextBlock x:Name="RemoteStateBadgeTextBlock"
                                           Text="DETENIDO"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#8CB3CC" />
                            </Border>

                            <Button Grid.Column="2"
                                    Click="CloseRemoteControlButton_Click"
                                    CornerRadius="8"
                                    Padding="8,5"
                                    Background="#071320"
                                    BorderBrush="#163A56"
                                    ToolTipService.ToolTip="Cerrar panel">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Primary Start / Stop Action -->
                        <Button x:Name="RemoteToggleServerButton"
                                Click="RemoteToggleServerButton_Click"
                                HorizontalAlignment="Stretch"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="#0A4C78"
                                BorderBrush="#38B6FF"
                                Foreground="#F0FAFF">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon x:Name="RemoteToggleServerIcon" Glyph="&#xE768;" FontSize="14" Foreground="#7FE0FF" />
                                <TextBlock x:Name="RemoteToggleServerTextBlock"
                                           Text="Iniciar servidor remoto"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Phone URL Card -->
                        <Border CornerRadius="10"
                                Padding="12"
                                Background="#05111E"
                                BorderBrush="#143957"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="DIRECCIÓN PARA TU TELÉFONO (MISMO WI-FI)"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="60"
                                           Foreground="#6E9EB8" />

                                <TextBox x:Name="RemotePrimaryUrlTextBox"
                                         IsReadOnly="True"
                                         Text="Servidor detenido"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         Foreground="#8EE0FF" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="RemoteCopyUrlButton"
                                            Click="RemoteCopyUrlButton_Click"
                                            IsEnabled="False"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="8"
                                            Padding="10,7"
                                            Background="#08243A"
                                            BorderBrush="#1E5F8A">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="#7AD5FF" />
                                            <TextBlock Text="Copiar URL" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="RemoteOpenBrowserButton"
                                            Grid.Column="1"
                                            Click="RemoteOpenBrowserButton_Click"
                                            IsEnabled="False"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="8"
                                            Padding="10,7"
                                            Background="#071826"
                                            BorderBrush="#184768">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="#7AD5FF" />
                                            <TextBlock Text="Abrir en PC" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="RemoteExtraUrlsTextBlock"
                                           FontSize="11"
                                           Foreground="#799FB8"
                                           TextWrapping="Wrap"
                                           Text="Inicia el servidor para generar tu enlace local http://IP:8787" />
                            </StackPanel>
                        </Border>

                        <!-- Settings Card -->
                        <Border CornerRadius="10"
                                Padding="12"
                                Background="#050F1A"
                                BorderBrush="#112E45"
                                BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="CONFIGURACIÓN DEL SERVIDOR"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="60"
                                           Foreground="#6E9EB8" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="RemotePortTextBox"
                                             Header="Puerto"
                                             PlaceholderText="8787"
                                             Text="8787" />

                                    <PasswordBox x:Name="RemotePinBox"
                                                 Grid.Column="1"
                                                 Header="PIN opcional (vacío = libre)"
                                                 PlaceholderText="Sin PIN" />
                                </Grid>

                                <ToggleSwitch x:Name="RemoteAllowLanToggle"
                                              Header="Permitir acceso por red local Wi-Fi (teléfonos)"
                                              OnContent="Red local (0.0.0.0)"
                                              OffContent="Solo este PC (localhost)"
                                              IsOn="True" />

                                <ToggleSwitch x:Name="RemoteAutoStartToggle"
                                              Header="Iniciar automáticamente al abrir Zenith Audio"
                                              OnContent="Activado"
                                              OffContent="Desactivado"
                                              IsOn="False" />

                                <Button Click="RemoteSaveSettingsButton_Click"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="8"
                                        Padding="10,7"
                                        Background="#071F33"
                                        BorderBrush="#1A547A">
                                    <TextBlock Text="Guardar configuración (reinicia si está activo)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#CBEAFF" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Connected clients & Firewall note -->
                        <Border CornerRadius="10"
                                Padding="10,9"
                                Background="#040D17"
                                BorderBrush="#0F2A3F"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="RemoteClientsStatusTextBlock"
                                           Text="Dispositivos activos: 0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#9BD5F7" />
                                <TextBlock x:Name="RemoteStatusDetailTextBlock"
                                           Text="Al iniciar por primera vez, permite ZenithAudio en el Firewall de Windows (red privada) para entrar desde tu celular."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#7398B2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
