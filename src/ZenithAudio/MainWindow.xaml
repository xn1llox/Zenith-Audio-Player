<Window
    x:Class="ZenithAudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Zenith Audio">

    <Grid x:Name="RootGrid"
          RequestedTheme="Dark"
          Padding="16,12,16,14"
          RowSpacing="12"
          Background="#000000"
          SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR (ADAPTIVE 1-ROW OR 2-ROW) -->
        <Border x:Name="TopHeaderBorder"
                CornerRadius="12"
                Padding="16,10"
                Background="#040910"
                BorderBrush="#10293E"
                BorderThickness="1">
            <Grid x:Name="TopHeaderGrid" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image x:Name="BrandLogoImage"
                           Source="Assets/Logo.png"
                           Width="38"
                           Height="38"
                           Stretch="Uniform" />
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BrandTitleTextBlock"
                                   Text="Zenith Audio"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#EAF6FF" />
                        <TextBlock x:Name="BrandSubtitleTextBlock"
                                   Text="Mesa de escucha bit-perfect"
                                   FontSize="11"
                                   Foreground="#7AA6C4" />
                    </StackPanel>
                </StackPanel>

                <!-- Audio output & engine bar (moves to Row 1 on narrow/half-screen snap) -->
                <Border x:Name="AudioOutputBarBorder"
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Padding="10,6"
                        Background="#02070D"
                        BorderBrush="#112E45"
                        BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7F5;"
                                  FontSize="14"
                                  Foreground="#5DBFFF"
                                  VerticalAlignment="Center" />

                        <ComboBox x:Name="QuickOutputDeviceComboBox"
                                  Grid.Column="1"
                                  Width="240"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Salida de audio"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Seleccionar salida de audio (estilo foobar2000)"
                                  SelectionChanged="QuickOutputDeviceComboBox_SelectionChanged" />

                        <ComboBox x:Name="BackendComboBox"
                                  Grid.Column="2"
                                  Width="166"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Motor de reproducción (WASAPI / ASIO / BASS / MPV)"
                                  SelectionChanged="BackendComboBox_SelectionChanged">
                            <ComboBoxItem Content="Zenith WASAPI" Tag="ZenithWasapi" />
                            <ComboBoxItem Content="ASIO (DSD Nativo)" Tag="AsioNative" />
                            <ComboBoxItem Content="BASS WASAPI" Tag="BassWasapi" />
                            <ComboBoxItem Content="MPV WASAPI" Tag="MpvWasapi" />
                        </ComboBox>

                        <Border x:Name="OutputBarDivider"
                                Grid.Column="3"
                                Width="1"
                                Height="22"
                                Background="#153752"
                                VerticalAlignment="Center" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="ExclusiveLabelTextBlock"
                                       Text="Exclusivo"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#9BC5E0"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ExclusiveModeToggle"
                                          MinWidth="0"
                                          Padding="0"
                                          OnContent="ON"
                                          OffContent="OFF"
                                          IsOn="False"
                                          VerticalAlignment="Center"
                                          Toggled="ExclusiveModeToggle_Toggled" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick actions + responsive pane toggles -->
                <StackPanel x:Name="HeaderActionsPanel"
                            Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ToggleLibraryPaneButton"
                            Visibility="Collapsed"
                            Click="ToggleLibraryPaneButton_Click"
                            CornerRadius="8"
                            Padding="10,7"
                            Background="#071320"
                            BorderBrush="#173D5B"
                            ToolTipService.ToolTip="Mostrar u ocultar biblioteca">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="#8AD4FF" />
                            <TextBlock x:Name="ToggleLibraryPaneLabel" Text="Biblioteca" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToggleInspectorPaneButton"
                            Visibility="Collapsed"
                            Click="ToggleInspectorPaneButton_Click"
                            CornerRadius="8"
                            Padding="10,7"
                            Background="#071320"
                            BorderBrush="#173D5B"
                            ToolTipService.ToolTip="Mostrar u ocultar panel de Señal / EQ / Ajustes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9E9;" FontSize="13" Foreground="#8AD4FF" />
                            <TextBlock x:Name="ToggleInspectorPaneLabel" Text="Panel" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenFileButton"
                            Click="OpenFileButton_Click"
                            CornerRadius="8"
                            Padding="11,7"
                            Background="#071320"
                            BorderBrush="#173D5B"
                            ToolTipService.ToolTip="Abrir archivo de audio">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" Foreground="#8AD4FF" />
                            <TextBlock x:Name="OpenFileLabelTextBlock" Text="Abrir" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ZenithAiButton"
                            Click="ZenithAiButton_Click"
                            CornerRadius="8"
                            Padding="11,7"
                            Background="#072840"
                            BorderBrush="#2687C4"
                            ToolTipService.ToolTip="ZenithAI (BETA) para música, formatos y escucha audiófila">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D4;" FontSize="14" Foreground="#6FD0FF" />
                            <TextBlock x:Name="ZenithAiLabelTextBlock" Text="ZenithAI" FontSize="13" FontWeight="SemiBold" Foreground="#DFF4FF" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RemoteControlButton"
                            Click="RemoteControlButton_Click"
                            CornerRadius="8"
                            Padding="11,7"
                            Background="#071320"
                            BorderBrush="#173D5B"
                            ToolTipService.ToolTip="Control remoto web por Wi-Fi / LAN para teléfono (Iniciar / Detener)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="RemoteStatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#4E748F"
                                     VerticalAlignment="Center" />
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,18.5 A 1.7,1.7 0 1 1 11.99,18.5 Z" Fill="#7ED4FF" />
                                    <Path Data="M 8.2,14.8 A 5.4,5.4 0 0 1 15.8,14.8" Stroke="#7ED4FF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M 4.8,11.3 A 10.2,10.2 0 0 1 19.2,11.3" Stroke="#7ED4FF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M 1.6,7.8 A 14.8,14.8 0 0 1 22.4,7.8" Stroke="#50B8F0" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="RemoteLabelTextBlock" Text="Remoto" FontSize="13" FontWeight="SemiBold" Foreground="#D4EEFF" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN ADAPTIVE 3-COLUMN WORKSPACE -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="284" />
                <ColumnDefinition x:Name="CenterStageColumn" Width="*" />
                <ColumnDefinition x:Name="RightInspectorColumn" Width="332" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: LIBRARY -->
            <Grid x:Name="LeftSidebarGrid" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Compact 2x2 Library Navigation -->
                <Border CornerRadius="12"
                        Padding="12"
                        Background="#040910"
                        BorderBrush="#10283D"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="BIBLIOTECA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="#6D9BB8" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Background="#07121E"
                                    BorderBrush="#13334D"
                                    Click="ShowMusicFoldersButton_Click"
                                    ToolTipService.ToolTip="Ver o elegir carpetas de música">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#6BC9FF" />
                                    <TextBlock Text="Carpetas" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Background="#07121E"
                                    BorderBrush="#13334D"
                                    Click="ShowDsdLibraryButton_Click"
                                    ToolTipService.ToolTip="Filtrar archivos DSD (DSF / DFF / ISO)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE142;" FontSize="13" Foreground="#6BC9FF" />
                                    <TextBlock Text="DSD" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Background="#07121E"
                                    BorderBrush="#13334D"
                                    Click="ShowHiResLibraryButton_Click"
                                    ToolTipService.ToolTip="Filtrar archivos Hi-Res PCM (FLAC / WAV / AIFF / ALAC)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="#6BC9FF" />
                                    <TextBlock Text="Hi-Res PCM" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Background="#07121E"
                                    BorderBrush="#13334D"
                                    Click="ShowSettingsButton_Click"
                                    ToolTipService.ToolTip="Abrir ajustes de salida, ASIO y DSD">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#6BC9FF" />
                                    <TextBlock Text="Ajustes" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Library Explorer -->
                <Border Grid.Row="1"
                        CornerRadius="12"
                        Padding="14"
                        Background="#040910"
                        BorderBrush="#10283D"
                        BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="LibraryBrowserTitleTextBlock"
                                           Text="Explorador de biblioteca"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LibraryBrowserSubtitleTextBlock"
                                           Text="Agrega una carpeta de música para escanear pistas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#7FA3BC" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Button Click="AddMusicFolderButton_Click"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="7"
                                        Padding="8,6"
                                        Background="#06192A"
                                        BorderBrush="#164467"
                                        ToolTipService.ToolTip="Seleccionar y agregar una carpeta de música">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xECC8;" FontSize="12" Foreground="#6FCBFF" />
                                        <TextBlock Text="+ Carpeta" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Click="UseWindowsMusicButton_Click"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="7"
                                        Padding="8,6"
                                        Background="#06192A"
                                        BorderBrush="#164467"
                                        ToolTipService.ToolTip="Cargar carpeta Música de Windows">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="#6FCBFF" />
                                        <TextBlock Text="Música Win" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <AutoSuggestBox x:Name="LibrarySearchBox"
                                            PlaceholderText="Buscar pista, álbum o formato..."
                                            TextChanged="LibrarySearchBox_TextChanged">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE721;" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                        </StackPanel>

                        <ListView x:Name="LibraryBrowserListView"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="LibraryBrowserListView_ItemClick"
                                  DoubleTapped="LibraryBrowserListView_DoubleTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,2" />
                                    <Setter Property="MinHeight" Value="34" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="34">
                                        <TextBlock Text="{Binding HeaderText}"
                                                   Visibility="{Binding HeaderVisibility}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#5D8FAD"
                                                   IsHitTestVisible="False"
                                                   Margin="2,8,0,2" />

                                        <Grid Visibility="{Binding TrackVisibility}"
                                              ColumnSpacing="8"
                                              Padding="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="1" MinWidth="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SubTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           FontSize="11"
                                                           Foreground="#7D9DB5" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    Background="{Binding BadgeBackground}"
                                                    BorderBrush="{Binding BadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           Foreground="{Binding BadgeForeground}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Compact Device Profile Card -->
                <Border Grid.Row="2"
                        CornerRadius="12"
                        Padding="12,10"
                        Background="#040910"
                        BorderBrush="#10283D"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PERFIL DE AUDÍFONOS / DAC"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="#6D9BB8" />
                        <ComboBox x:Name="DeviceProfileComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="DAC neutral" />
                            <ComboBoxItem Content="KZ Carol Pro" />
                            <ComboBoxItem Content="Moondrop" />
                            <ComboBoxItem Content="Sennheiser HD" />
                            <ComboBoxItem Content="Sony IER" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CENTER COLUMN: NOW PLAYING STAGE -->
            <Border Grid.Column="1"
                    x:Name="MainListeningPanelBorder"
                    CornerRadius="12"
                    Padding="20,18"
                    Background="#010409"
                    BorderBrush="#123A55"
                    BorderThickness="1">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Now Playing Title & Status Pill -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock Text="REPRODUCIENDO AHORA"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="90"
                                       Foreground="#6CA8CF" />
                            <TextBlock x:Name="TrackTitleTextBlock"
                                       Text="No hay archivo cargado"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="#F0F8FF" />
                            <TextBlock x:Name="TrackPathTextBlock"
                                       Text="Abre un archivo DSF, DFF, FLAC, WAV, AIFF, ALAC o selecciona desde tu biblioteca"
                                       FontSize="12"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#7B9EB8" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                CornerRadius="14"
                                Padding="14,6"
                                Background="#083454"
                                BorderBrush="#2DA4EC"
                                BorderThickness="1">
                            <TextBlock x:Name="TransportBadgeTextBlock"
                                       Text="LISTO"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="60"
                                       Foreground="#DFF5FF" />
                        </Border>
                    </Grid>

                    <!-- Cover Art + Telemetry + Tabs (Adaptive 2-col or stacked) -->
                    <Grid x:Name="ListeningContentGrid" Grid.Row="1" ColumnSpacing="16" RowSpacing="12" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CoverArtColumn" Width="244" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Album Cover Card -->
                        <Border x:Name="CoverCardBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="244"
                                CornerRadius="12"
                                Padding="12"
                                Background="#03080F"
                                BorderBrush="#153A52"
                                BorderThickness="1">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="CoverArtImageRow" Height="220" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="CoverGlowBorder"
                                        CornerRadius="12"
                                        Background="#062842"
                                        Opacity="0.32"
                                        Margin="-6"
                                        IsHitTestVisible="False" />

                                <Border CornerRadius="8" Background="#010913">
                                    <Grid>
                                        <Image x:Name="CoverArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed" />
                                        <StackPanel x:Name="CoverPlaceholderPanel"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8">
                                            <Image x:Name="CoverPlaceholderLogoImage"
                                                   Width="104"
                                                   Height="104"
                                                   HorizontalAlignment="Center"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="ZENITH"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       CharacterSpacing="140"
                                                       Foreground="#76C8FF" />
                                            <TextBlock Text="SIN CARÁTULA"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="#6E95B0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Spacing="4" Margin="2,2,2,0">
                                    <TextBlock x:Name="AlbumTitleTextBlock"
                                               Text="Carátula del álbum"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock x:Name="CoverHintTextBlock"
                                               Text="Busca cover.jpg/png o carátula embebida"
                                               FontSize="11"
                                               Foreground="#799CB5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right Listening Stage -->
                        <Grid x:Name="ListeningStageGrid" Grid.Row="0" Grid.Column="1" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Telemetry Strip -->
                            <Border CornerRadius="10"
                                    Padding="14,10"
                                    Background="#030B14"
                                    BorderBrush="#123A55"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="MODO" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#6C9BB8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ModeTextBlock" Text="WASAPI Comp." FontSize="14" FontWeight="SemiBold" Foreground="#DFF4FF" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Height="16" Background="#133852" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="MOTOR" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#6C9BB8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BackendTextBlock" Text="WASAPI" FontSize="14" FontWeight="SemiBold" Foreground="#76CCFF" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Width="1" Height="16" Background="#133852" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="BUFFER" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#6C9BB8" VerticalAlignment="Center" />
