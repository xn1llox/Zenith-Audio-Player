                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Custom Vector Hi-Fi Transport Controls -->
                <StackPanel x:Name="TransportControlsPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <Button x:Name="ShuffleButton"
                            Click="ShuffleButton_Click"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="9"
                            Background="#072238"
                            BorderBrush="#2485C4"
                            BorderThickness="1"
                            ToolTipService.ToolTip="Reproducción aleatoria">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="ShuffleIconPath"
                                      Stroke="#72D0FF"
                                      StrokeThickness="2"
